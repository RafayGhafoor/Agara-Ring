        "rhr_delta_percent": 12,
        "sleep_under_goal_hours": 2.0,
        "night_data_percent": 96,
        "baseline_nights": 21
      },
      "ledger": {},
      "expect": {
        "emit": [
          "a1"
        ],
        "push_count": 1
      }
    },
