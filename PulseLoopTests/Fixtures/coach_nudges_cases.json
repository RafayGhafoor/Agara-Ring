{
  "version": 1,
  "about": "Worked examples for CoachNudgePolicy (docs/apps/coach-nudges.md). Each case is a pure input -> expected output: which nudges are emitted, in what order, and which are silent and why. The policy is a pure function, so these are checked without a clock, a database or a network. Edge cases matter more than happy paths: every 'silent' reason exists because a rule would otherwise nag.",
  "schema": {
    "now": "ISO-8601 local time the policy is evaluated at",
    "signals": "the CoachSignals snapshot: baselines, last night, today so far, recent history",
    "ledger": "what was already sent / dismissed (fingerprints, per-day counts, per-category gaps, snoozes)",
    "expect": {
      "emit": "nudge ids in the order they are delivered (first = highest priority)",
      "silent": "nudge ids that must NOT be emitted, with the reason (documented per case)",
      "push_count": "routine pushes allowed by the policy for this case"
    }
  },
  "cases": [
    {
      "id": "a1-fires-on-two-signals",
